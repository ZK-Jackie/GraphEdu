from graphedu.common.models.vo.base import PageResponse
from graphedu.common.models.dto.{{ businessName }} import (
    {{ ClassName }}CreateDTO,
    {{ ClassName }}QueryDTO,
    {{ ClassName }}UpdateDTO,
)
