logger = logging.getLogger(__name__)


def _convert_orm_to_tree_vo({{ className }}: {{ ClassName }}Tree, children: list[{{ ClassName }}TreeVO] | None = None) -> {{ ClassName }}TreeVO:
    """将 ORM 对象转换为 {{ ClassName }}TreeVO。

    Args:
        {{ className }}: ORM {{ functionName }}对象。
        children: 子节点列表。

    Returns:
        {{ ClassName }}TreeVO: {{ functionName }}树形视图对象。
    """
    return {{ ClassName }}TreeVO(
        {% for column in columns %}
        {{ column.pythonField }}={{ className }}.{{ column.pythonField }},
        {% endfor %}
        children=children if children is not None else [],
    )


def _build_{{ className }}_tree({{ className }}_list: list[{{ ClassName }}Tree]], parent_id: Any = {% if treeParentCode and pkColumn.pythonType == 'int' %}0{% elif treeParentCode and pkColumn.pythonType == 'str' %}""{% else %}None{% endif %}) -> list[{{ ClassName }}TreeVO]:
    """将{{ functionName }}列表转换为树形结构。

    Args:
        {{ className }}_list: {{ functionName }} ORM 列表。
        parent_id: 父节点 ID。

    Returns:
        list[{{ ClassName }}TreeVO]: {{ functionName }}树形列表。
    """
    tree = []
    for {{ className }} in {{ className }}_list:
        {% if treeParentCode %}
        if {{ className }}.{{ treeParentCode }} == parent_id:
            children = _build_{{ className }}_tree({{ className }}_list, {{ className }}.{{ pkColumn.pythonField }})
            node = _convert_orm_to_tree_vo({{ className }}, children if children else None)
            tree.append(node)
        {% else %}
        node = _convert_orm_to_tree_vo({{ className }})
        tree.append(node)
        {% endif %}
    return tree


class {{ ClassName }}Service:
    """{{ functionName }}管理服务类（树表）。

    提供{{ functionName }}的查询、新增、更新和删除功能，支持树表结构和异步展开。
    """

    @staticmethod
    async def get_{{ className }}_children(
        query_db: AsyncSession,
        query_object: {{ ClassName }}QueryDTO | None = None,
        {% if treeParentCode %}
        parent_id: Any = {% if pkColumn.pythonType == 'int' %}0{% elif pkColumn.pythonType == 'str' %}""{% else %}None{% endif %},
        {% endif %}
    ) -> list[{{ ClassName }}TreeVO]:
        """根据父节点 ID 获取子节点列表（异步展开接口）。

        用于自行构建树形结构或异步获取{{ functionName }}树。

        Args:
            query_db: 数据库会话。
            query_object: 查询参数 DTO（可选）。
            {% if treeParentCode %}parent_id: 父节点 ID{% endif %}

        Returns:
            list[{{ ClassName }}TreeVO]: 给定父节点 ID 的子节点列表（含 has_children 标记）。
        """
        # 获取子节点列表
        {% if treeParentCode %}
        {{ className }}_list = await {{ ClassName }}Mapper.get_{{ className }}_children(parent_id, query_object, query_db)
        {% else %}
        {{ className }}_list = await {{ ClassName }}Mapper.get_{{ className }}_children(None, query_object, query_db)
        {% endif %}

        # 检查每个节点是否有子节点
        {{ className }}_vo_list = []
        for {{ className }} in {{ className }}_list:
            has_children = await {{ ClassName }}Mapper.has_children({{ className }}.{{ pkColumn.pythonField }}, query_db)
            {{ className }}_vo = {{ ClassName }}TreeVO.model_validate({{ className }})
            {{ className }}_vo.has_children = has_children
            {{ className }}_vo_list.append({{ className }}_vo)

        return {{ className }}_vo_list

    @staticmethod
    async def get_{{ className }}_tree(
        query_db: AsyncSession,
        query_object: {{ ClassName }}QueryDTO | None = None,
    ) -> list[{{ ClassName }}TreeVO]:
        """获取完整{{ functionName }}树形列表（同步加载接口）。

        Args:
            query_db: 数据库会话。
            query_object: 查询参数 DTO（可选）。

        Returns:
            list[{{ ClassName }}TreeVO]: {{ functionName }}树形列表 VO。
        """
        {% if treeParentCode %}
        {{ className }}_list_result, _ = await {{ ClassName }}Mapper.get_{{ className }}_list(query_object or {{ ClassName }}QueryDTO(), query_db)
        {% else %}
        {{ className }}_list_result, _ = await {{ ClassName }}Mapper.get_{{ className }}_list(query_object, query_db)
        {% endif %}
        logger.debug(f"获取{{ functionName }}树形列表成功，共 {len({{ className }}_list_result)} 条记录")
        return _build_{{ className }}_tree(list({{ className }}_list_result))

    @staticmethod
    async def get_{{ className }}_list(
        query_db: AsyncSession,
        query_object: {{ ClassName }}QueryDTO,
    ) -> PageResponse[{{ ClassName }}ListVO]:
        """获取{{ functionName }}列表（分页）。

        Args:
            query_db: 数据库会话。
            query_object: 查询参数对象。

        Returns:
            PageResponse[{{ ClassName }}ListVO]: {{ functionName }}分页结果。
        """
        {{ className }}_list_result, total = await {{ ClassName }}Mapper.get_{{ className }}_list(query_object, query_db)
        vo_list = [{{ ClassName }}ListVO.model_validate(item) for item in {{ className }}_list_result]

        return PageResponse(
            rows=vo_list,
            page=query_object.page or 1,
            size=query_object.size or 10,
            total=total,
        )

    @staticmethod
    async def get_{{ className }}_detail(
        {{ pkColumn.pythonField }}: {% if pkColumn.pythonType == 'int' %}int{% elif pkColumn.pythonType == 'str' %}str{% elif pkColumn.pythonType == 'datetime' %}datetime{% else %}{{ pkColumn.pythonType }}{% endif %},
        query_db: AsyncSession,
    ) -> {{ ClassName }}DetailVO | None:
        """获取{{ functionName }}详情。

        Args:
            {{ pkColumn.pythonField }}: {{ pkColumn.columnComment }}
            query_db: 数据库会话

        Returns:
            {{ ClassName }}DetailVO | None: {{ functionName }}详情 VO，如果不存在则返回 None。
        """
        orm_result = await {{ ClassName }}Mapper.get_by_id({{ pkColumn.pythonField }}, query_db)
        if orm_result:
            return {{ ClassName }}DetailVO.model_validate(orm_result)
        return None

    @staticmethod
    async def add_{{ className }}(
        query_db: AsyncSession,
        {{ className }}_dto: {{ ClassName }}CreateDTO,
    ) -> None:
        """新增{{ functionName }}。

        Args:
            query_db: 数据库会话。
            {{ className }}_dto: 新增{{ functionName }} DTO。
        """
        # DTO -> ORM
        new_orm = {{ ClassName }}Tree(**{{ className }}_dto.model_dump())
        await {{ ClassName }}Mapper.add_{{ className }}(new_orm, query_db)
        logger.info("新增{{ functionName }}成功")

    @staticmethod
    async def update_{{ className }}(
        query_db: AsyncSession,
        {{ className }}_dto: {{ ClassName }}UpdateDTO,
    ) -> None:
        """更新{{ functionName }}。

        Args:
            query_db: 数据库会话。
            {{ className }}_dto: 更新{{ functionName }} DTO。
        """
        # 获取现有记录
        existing_orm = await {{ ClassName }}Mapper.get_by_id({{ className }}_dto.{{ pkColumn.pythonField }}, query_db)
        if not existing_orm:
            raise ValueError("{{ functionName }}不存在")

        # DTO -> ORM（更新字段）
        update_data = {{ className }}_dto.model_dump(exclude_unset=True)
        for field, value in update_data.items():
            setattr(existing_orm, field, value)

        await {{ ClassName }}Mapper.update_{{ className }}(existing_orm, query_db)
        logger.info(f"更新{{ functionName }}成功: {{{{ className }}_dto.{{ pkColumn.pythonField }}}}")

    @staticmethod
    async def delete_{{ className }}(
        query_db: AsyncSession,
        {{ pkColumn.pythonField }}s: list[
            {% if pkColumn.pythonType == 'int' %}int{% elif pkColumn.pythonType == 'str' %}str{% elif pkColumn.pythonType == 'datetime' %}datetime{% else %}{{ pkColumn.pythonType }}{% endif %}
        ],
    ) -> None:
        """删除{{ functionName }}（支持批量删除）。

        Args:
            query_db: 数据库会话。
            {{ pkColumn.pythonField }}s: {{ functionName }} ID 列表。
        """
        for {{ pkColumn.pythonField }} in {{ pkColumn.pythonField }}s:
            await {{ ClassName }}Mapper.delete_{{ className }}({{ pkColumn.pythonField }}, query_db)
            logger.info(f"删除{{ functionName }}成功: {{{{ pkColumn.pythonField }}}}")
