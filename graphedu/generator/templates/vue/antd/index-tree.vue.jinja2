<template>
  <TablePageLayout>
    <!-- 搜索表单 -->
    <template #search>
      <a-card :bordered="false">
        <a-form layout="inline" :model="queryParams">
          {% for column in columns if column.query == '1' and column.pythonField not in ['parentId', 'createTime', 'updateTime'] %}
          {% if column.htmlType == 'input' or column.htmlType == 'textarea' %}
          <a-form-item :label="$t('{{ moduleName }}.{{ businessName }}.{{ column.pythonField }}')">
            <a-input
              v-model:value="queryParams.{{ column.pythonField }}"
              :placeholder="$t('common.pleaseInput') + $t('{{ moduleName }}.{{ businessName }}.{{ column.pythonField }}')"
              allow-clear
              style="width: 200px"
              @press-enter="handleQuery"
            />
          </a-form-item>
          {% elif column.htmlType == 'select' or column.htmlType == 'radio' %}
          <a-form-item :label="$t('{{ moduleName }}.{{ businessName }}.{{ column.pythonField }}')">
            <DictSelect
              v-model:model-value="queryParams.{{ column.pythonField }}"
              dict-type="{{ column.dictType }}"
              :placeholder="$t('common.pleaseSelect') + $t('{{ moduleName }}.{{ businessName }}.{{ column.pythonField }}')"
              allow-clear
              style="width: 150px"
            />
          </a-form-item>
          {% endif %}
          {% endfor %}
          <a-form-item>
            <a-space>
              <a-button type="primary" @click="handleQuery">
                <template #icon><SearchOutlined /></template>
                {{ $t('common.search') }}
              </a-button>
              <a-button @click="resetQuery">
                <template #icon><ReloadOutlined /></template>
                {{ $t('common.reset') }}
              </a-button>
            </a-space>
          </a-form-item>
        </a-form>
      </a-card>
    </template>

    <!-- 操作按钮 -->
    <template #actions>
      <a-space>
        <a-button type="primary" @click="handleAdd">
          <template #icon><PlusOutlined /></template>
          {{ $t('{{ moduleName }}.{{ businessName }}.add') }}
        </a-button>
        <a-button type="default" @click="toggleExpandAll">
          <template #icon><UnorderedListOutlined /></template>
          {{ isExpandAll ? $t('common.collapse') : $t('common.expand') }}
        </a-button>
      </a-space>
    </template>

    <!-- {{ functionName }}树表格 -->
    <template #table="{ scrollY }">
      <a-table
        v-if="refreshTable"
        :columns="columns"
        :data-source="{{ className }}List"
        :loading="loading"
        :pagination="false"
        :expand-row-by-click="false"
        :default-expand-all-rows="false"
        :expanded-row-keys="expandedRowKeys"
        row-key="{{ pkColumn.pythonField }}"
        :scroll="{ x: 'max-content', y: scrollY }"
        @expand="handleExpand"
      >
        <template #bodyCell="{ column, record }">
          {% for column in columns if column.list == '1' %}
          {% if column.dictType %}
          <!-- {{ column.columnComment }}列 -->
          <template v-if="column.key === '{{ column.pythonField }}'">
            <DictTag :options="{{ column.dictType }}" :value="record.{{ column.pythonField }}" />
          </template>
          {% elif column.pythonType == 'datetime' %}
          <!-- {{ column.columnComment }}列 -->
          <template v-else-if="column.key === '{{ column.pythonField }}'">
            {{ '{ ' }}formatTime(record.{{ column.pythonField }}){{ '}' }}
          </template>
          {% endif %}
          {% endfor %}
          <!-- 操作列 -->
          <template v-else-if="column.key === 'action'">
            <a-space>
              <a-tooltip :title="$t('common.edit')">
                <a-button type="link" size="small" @click="handleUpdate(record)">
                  <template #icon><EditOutlined /></template>
                </a-button>
              </a-tooltip>
              <a-tooltip :title="$t('{{ moduleName }}.{{ businessName }}.addChild')">
                <a-button type="link" size="small" @click="handleAddChild(record)">
                  <template #icon><PlusOutlined /></template>
                </a-button>
              </a-tooltip>
              {% if treeParentCode %}
              <a-tooltip v-if="record.{{ treeParentCode }} !== 0" :title="$t('common.delete')">
                <a-button type="link" size="small" danger @click="handleDelete(record)">
                  <template #icon><DeleteOutlined /></template>
                </a-button>
              </a-tooltip>
              {% endif %}
            </a-space>
          </template>
        </template>
      </a-table>
    </template>
  </TablePageLayout>

  <!-- {{ functionName }}表单弹窗 -->
  <{{ ClassName }}Form
    v-model:visible="formVisible"
    :{{ pkColumn.pythonField }}="current{{ pkColumn.pythonField | to_pascal }}"
    :{{ treeParentCode }}="current{{ treeParentCode | to_pascal }}"
    @success="handleFormSuccess"
  />
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { useI18n } from 'vue-i18n'
import { message, Modal } from 'ant-design-vue'
import type { TableProps } from 'ant-design-vue'
import {
  SearchOutlined,
  ReloadOutlined,
  PlusOutlined,
  EditOutlined,
  DeleteOutlined,
  UnorderedListOutlined,
} from '@ant-design/icons-vue'
import { get{{ ClassName }}Tree, get{{ ClassName }}Children, delete{{ ClassName }} } from '@/api/system/{{ businessName }}'
import type { {{ ClassName }}QueryDTO, {{ ClassName }}TreeVO } } from '@/types/api/{{ businessName }}'
import { useDict } from '@/utils/dict'
import DictTag from '@/components/dict/DictTag.vue'
import DictSelect from '@/components/dict/DictSelect.vue'
import TablePageLayout from '@/layout/TablePageLayout.vue'
import {{ ClassName }}Form from './components/{{ ClassName }}Form.vue'

const { t } = useI18n()

// 获取字典数据
{% for column in columns if column.dictType %}
const {{ column.dictType }} = useDict('{{ column.dictType }}').{{ column.dictType }}
{% endfor %}

// 表格列定义
const columns = [
  {% for column in columns if column.list == '1' %}
  { title: t('{{ moduleName }}.{{ businessName }}.{{ column.pythonField }}'), dataIndex: '{{ column.pythonField }}', key: '{{ column.pythonField }}', width: {{ column.listWidth or 180 }}{% if column.pythonType == 'str' %}, ellipsis: true{% endif %} },
  {% endfor %}
  { title: t('common.operation'), key: 'action', fixed: 'right', width: 200 },
]

// 数据状态
const loading = ref(false)
const {{ className }}List = ref<{{ ClassName }}TreeVO[]>([])
const isExpandAll = ref(false)
const refreshTable = ref(true)
const expandedRowKeys = ref<{% if pkColumn.pythonType == 'int' %}number[]{% else %}string[]{% endif %}>([])

// 查询参数
const queryParams = reactive<{{ ClassName }}QueryDTO>({
  {% for column in columns if column.query == '1' and column.pythonField not in ['parentId', 'createTime', 'updateTime'] %}
  {{ column.pythonField }}: undefined,
  {% endfor %}
})

// 弹窗状态
const formVisible = ref(false)
const current{{ pkColumn.pythonField | to_pascal }} = ref<{% if pkColumn.pythonType == 'int' %}number{% elif pkColumn.pythonType == 'str' %}string{% else %}{{ pkColumn.pythonType }}{% endif %}>()
const current{{ treeParentCode | to_pascal }} = ref<{% if treeParentCode and pkColumn.pythonType == 'int' %}number{% elif treeParentCode and pkColumn.pythonType == 'str' %}string{% else %}number{% endif %}>()

// 获取{{ functionName }}根节点列表
const getList = async () => {
  loading.value = true
  try {
    const res = await get{{ ClassName }}Tree(queryParams)
    if (res.code === 200) {
      {{ className }}List.value = (res.data || []).map(item => ({
        ...item,
        children: item.has_children ? [] : undefined,  // 有子节点时初始化为空数组，否则设为 undefined
      }))
    }
  } catch (_e) {
    message.error(t('{{ moduleName }}.{{ businessName }}.getListFailed'))
  } finally {
    loading.value = false
  }
}

// 异步展开处理
const handleExpand: TableProps['onExpand'] = async (expanded, record) => {
  if (expanded) {
    // 添加到展开列表
    expandedRowKeys.value.push(record.{{ pkColumn.pythonField }})

    // 如果已经有子节点数据，不需要重新加载
    if (record.children && record.children.length > 0) {
      return
    }

    // 检查是否有子节点
    if (!record.hasChildren) {
      return
    }

    // 异步加载子节点
    try {
      const res = await get{{ ClassName }}Children(record.{{ pkColumn.pythonField }}, queryParams)
      if (res.code === 200) {
        const children = (res.data || []).map(child => ({
          ...child,
          children: child.has_children ? [] : undefined,
        }))

        // 更新记录的子节点
        record.children = children
      }
    } catch (_e) {
      message.error(t('{{ moduleName }}.{{ businessName }}.getChildrenFailed'))
    }
  } else {
    // 从展开列表移除
    const index = expandedRowKeys.value.indexOf(record.{{ pkColumn.pythonField }})
    if (index > -1) {
      expandedRowKeys.value.splice(index, 1)
    }
  }
}

// 格式化时间
const formatTime = (time: string) => {
  if (!time) return ''
  return time
}

// 搜索
const handleQuery = () => {
  getList()
}

// 重置查询
const resetQuery = () => {
  {% for column in columns if column.query == '1' and column.pythonField not in ['parentId', 'createTime', 'updateTime'] %}
  queryParams.{{ column.pythonField }} = undefined
  {% endfor %}
  getList()
}

// 展开/折叠
const toggleExpandAll = () => {
  isExpandAll.value = !isExpandAll.value
  if (isExpandAll.value) {
    // 全部展开：收集所有有子节点的 ID
    const allKeys: {% if pkColumn.pythonType == 'int' %}number[]{% else %}string[]{% endif %} = []
    const collectKeys = (list: {{ ClassName }}TreeVO[]) => {
      list.forEach(item => {
        if (item.hasChildren) {
          allKeys.push(item.{{ pkColumn.pythonField }})
          if (item.children && item.children.length > 0) {
            collectKeys(item.children)
          }
        }
      })
    }
    collectKeys({{ className }}List.value)
    expandedRowKeys.value = allKeys
  } else {
    // 全部折叠
    expandedRowKeys.value = []
  }
}

// 新增
const handleAdd = () => {
  current{{ pkColumn.pythonField | to_pascal }}.value = undefined
  {% if treeParentCode %}
  current{{ treeParentCode | to_pascal }}.value = {% if pkColumn.pythonType == 'int' %}0{% elif pkColumn.pythonType == 'str' %}""{% else %}null{% endif %}
  {% endif %}
  formVisible.value = true
}

// 新增子节点
const handleAddChild = (record: {{ ClassName }}TreeVO) => {
  current{{ pkColumn.pythonField | to_pascal }}.value = undefined
  {% if treeParentCode %}
  current{{ treeParentCode | to_pascal }}.value = record.{{ pkColumn.pythonField }}
  {% endif %}
  formVisible.value = true
}

// 修改
const handleUpdate = (record: {{ ClassName }}TreeVO) => {
  current{{ pkColumn.pythonField | to_pascal }}.value = record.{{ pkColumn.pythonField }}
  {% if treeParentCode %}
  current{{ treeParentCode | to_pascal }}.value = undefined
  {% endif %}
  formVisible.value = true
}

// 删除
const handleDelete = (record: {{ ClassName }}TreeVO) => {
  const firstDisplayField = '{% for column in columns if column.list == '1' and column.pythonField not in ['id', 'parentId', 'createTime', 'updateTime'] %}{{ column.pythonField }}{% break %}{% endfor %}'

  Modal.confirm({
    title: t('common.systemTip'),
    content: t('{{ moduleName }}.{{ businessName }}.deleteConfirm', { name: record[firstDisplayField] }),
    onOk: async () => {
      try {
        const res = await delete{{ ClassName }}(String(record.{{ pkColumn.pythonField }}))
        if (res.code === 200) {
          message.success(t('common.deleteSuccess'))
          await getList()
        }
      } catch (_e) {
        message.error(t('common.deleteFailed'))
      }
    },
  })
}

// 表单提交成功
const handleFormSuccess = () => {
  formVisible.value = false
  getList()
}

// 初始化
onMounted(() => {
  getList()
})
</script>
