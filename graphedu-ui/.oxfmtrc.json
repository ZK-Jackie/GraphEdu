{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "es5",
  "arrowParens": "always",
  "tabWidth": 2,
  "endOfLine": "crlf",
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "vueIndentScriptAndStyle": false,
  "experimentalSortPackageJson": false,
  "ignorePatterns": ["**/*dist", "dist-ssr", "coverage", "*.local", "node_modules", ".pnpm-store"]
}
