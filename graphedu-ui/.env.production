VITE_APP_BASE_URL=/
VITE_APP_TITLE=GraphEdu

VITE_API_BASE_URL=/api
# API request timeout in milliseconds (e.g., 5000 for 5 seconds, default is 300000 for 5 minutes)
VITE_API_TIMEOUT=30000
# API request interval in milliseconds (e.g., 1000 for 1 second)
VITE_API_REQUEST_INTERVAL=1000
# API request interval check's max data size threshold in bytes (e.g., 2 * 1024 = 2048 for 2 KB, default is 5242880 for 5 MB)
VITE_API_REQUEST_INTERVAL_DATA_THRESHOLD=5242880

# Build compression method ('gzip', 'brotli')
VITE_BUILD_COMPRESS=brotli,gzip

# Login QR Code feature
VITE_LOGIN_QRCODE=true

# Licenses
VITE_ICP_LICENSE=粤ICP备2025457771号
VITE_PSA_LICENSE=